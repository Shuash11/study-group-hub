# Copy this file to client/.env.local and fill in your Supabase project values.
# Find them in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# SECURITY: only the "anon public" key belongs in the frontend.
# NEVER put the service_role key or your database password in this file.
# The anon key is safe because Row Level Security protects the actual data.
